# development | production | test
NODE_ENV=development
PORT=3000
# Ruxsat etilgan CORS manbasi ("*" — hammasi)
CORS_ORIGIN=*

# --- Telegram bot (@BotFather dan olinadi) ---
# TELEGRAM_BOT_TOKEN=123456789:AA...
# auto (production'da webhook) | polling (lokal sinov) | off
# DIQQAT: polling production webhook'ini o'chiradi — sinovdan keyin Render'ni qayta deploy qiling.
# TELEGRAM_MODE=auto

# --- Groq AI (bepul: https://console.groq.com/keys) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Sayt manzili (Render'da avtomatik: RENDER_EXTERNAL_URL)
# PUBLIC_URL=https://alloma-ai.onrender.com
